+/* Reproducible user_cache integration probe, outside the upstream host. */
+static bool uc_adapter_managed = false;
+static THREAD_LOCAL php_user_cache_scope_token uc_adapter_scope = 0;
+static void uc_adapter_abort(void) {
+  if (uc_adapter_scope != 0) {
+    php_user_cache_logical_request_end(uc_adapter_scope,
