@@ -1122,6 +1164,18 @@ static int frankenphp_startup(sapi_module_struct *sapi_module) {
   php_import_environment_variables = get_full_env;
 
   int result = php_module_startup(sapi_module, &frankenphp_module);
+  /* "legacy" reproduces the original REQUEST-mode opt-in probe. */
+  const char *uc_option = getenv("UC_LIFECYCLE_OPT_IN");
+  if (result == SUCCESS && uc_option != NULL) {
+    uc_adapter_managed = strcmp(uc_option, "legacy") != 0;
+    if (php_user_cache_opt_in(uc_adapter_managed
